{
  "name": "hex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/**/*.test.ts\" package.json prettier.config.js eslint.config.js vitest.config.ts \".github/workflows/*.{yml,yaml}\" --write",
    "format:check": "prettier \"src/**/*.test.ts\" package.json prettier.config.js eslint.config.js vitest.config.ts \".github/workflows/*.{yml,yaml}\" --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "graphql": "^17",
    "lucide-react": "^1.23.0",
    "monaco-editor": "^0.52.0",
    "monaco-graphql": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tauri-liquid-icon": "^1.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
